# ── Servidor ──
NODE_ENV=development
PORT=4000
# Origen del frontend (CORS + enlaces en correos)
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ── Base de datos (MySQL 8) ──
DATABASE_URL="mysql://root:@127.0.0.1:3306/cehacis_lms"
SHADOW_DATABASE_URL="mysql://root:@127.0.0.1:3306/cehacis_lms_shadow"

# ── Seguridad ── (genera valores con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# ── Archivos ──
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=200

# ── Correo (SMTP) — vacío = los correos quedan registrados en la bandeja interna ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CEHACIS <no-reply@cehacis.com>"

# ── Inteligencia artificial (Claude / Anthropic) — vacío = módulo "no configurado" ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Pagos ──
# sandbox = entorno de pruebas interno (no cobra dinero real). azul = pendiente de credenciales.
PAYMENT_PROVIDER=sandbox
AZUL_MERCHANT_ID=
AZUL_AUTH1=
AZUL_AUTH2=
AZUL_ENV=sandbox

# ── Videoconferencia — vacío = enlaces de reunión introducidos manualmente ──
VIDEO_PROVIDER=manual
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
